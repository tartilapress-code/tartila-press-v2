[
    {
        "id": "name",
        "name": "name",
        "label": "Full Name",
        "required": true,
        "type": "text",
        "placeholder": "John Doe",
        "autocomplete": "on",
        "min_length": 0,
        "max_length": 255,
        "error_message": "Massukan nama lengkap anda (contoh: Andi Fernandes)",
        "pattern": "^[a-zA-Z]+(?: [a-zA-Z]+)+$"
    },
    {
        "id": "email",
        "name": "email",
        "label": "E-mail",
        "required": true,
        "type": "email",
        "placeholder": "johndoe@email.com",
        "autocomplete": "on",
        "min_length": 0,
        "max_length": 255,
        "error_message": "Format email tidak valid. Gunakan tanda '@' dan domain yang benar (contoh: nama@email.com).",
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
    },
    {
        "id": "password",
        "name": "password",
        "label": "Password",
        "required": true,
        "type": "password",
        "placeholder": "*********",
        "autocomplete": "new-password",
        "min_length": 8,
        "max_length": 255,
        "error_message": "Password minimal 8 karakter, kombinasi huruf besar, huruf kecil, angka, dan simbol."
    },
    {
        "id": "password_confirmation",
        "name": "password_confirmation",
        "label": "Konfirmasi Password",
        "required": true,
        "type": "password",
        "placeholder": "*********",
        "autocomplete": "new-password",
        "min_length": 8,
        "max_length": 255,
        "error_message": "Konfirmasi password tidak sesuai."
    },
    {
        "id": "phone",
        "name": "phone",
        "label": "Nomor Telepon",
        "required": true,
        "type": "text",
        "placeholder": "081234567890",
        "autocomplete": "on",
        "min_length": 0,
        "max_length": 20,
        "error_message": "Masukan nomor telepon anda (contoh: 081234567890)",
        "pattern": "^[0-9+ ]+$"
    },
    {
        "id": "occupation",
        "name": "occupation",
        "label": "Pekerjaan / Profesi",
        "required": true,
        "type": "text",
        "placeholder": "Penulis",
        "autocomplete": "on",
        "min_length": 0,
        "max_length": 255,
        "error_message": "Masukan pekerjaan anda (contoh: Penulis)",
        "pattern": "^[a-zA-Z\\s]+$"
    },
    {
        "id": "age",
        "name": "age",
        "label": "Umur",
        "required": true,
        "type": "text",
        "placeholder": "25",
        "autocomplete": "on",
        "min_length": 1,
        "max_length": 3,
        "error_message": "Masukan usia anda (contoh: 25)",
        "pattern": "^\\d{1,3}$"
    },
    {
        "id": "institution",
        "name": "institution",
        "label": "Institusi / Sekolah (opsional)",
        "required": false,
        "type": "text",
        "placeholder": "Universitas Indonesia",
        "autocomplete": "on",
        "min_length": 0,
        "max_length": 255,
        "error_message": ""
    }
]

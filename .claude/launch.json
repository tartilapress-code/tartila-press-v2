{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "tartila-press-frontend",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "--prefix",
                "tartila-press-frontend",
                "run",
                "dev"
            ],
            "port": 5173
        },
        {
            "name": "tartila-book-frontend",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "--prefix",
                "tartila-book-frontend",
                "run",
                "dev"
            ],
            "port": 5174
        },
        {
            "name": "tartila-press-backend",
            "runtimeExecutable": "php",
            "runtimeArgs": [
                "tartila-press_backend/artisan",
                "serve",
                "--host=127.0.0.1",
                "--port=8000"
            ],
            "port": 8000
        }
    ]
}

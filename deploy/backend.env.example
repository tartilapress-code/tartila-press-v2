# Cetakan .env backend untuk SERVER. Salin ke tartila-press_backend/.env, lalu
# ganti semua nilai yang berawalan GANTI_. Jangan pernah meng-commit .env.
#
#   cp deploy/backend.env.example tartila-press_backend/.env
#   nano tartila-press_backend/.env
#   cd tartila-press_backend && php artisan key:generate --force

APP_NAME="Tartila Press"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://GANTI_DOMAIN

# Link di email (verifikasi email, reset password) mengarah ke frontend ini.
# Karena frontend dan API satu domain, isinya sama dengan APP_URL.
FRONTEND_URL=https://GANTI_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tartila_press
DB_USERNAME=tartila
DB_PASSWORD=GANTI_PASSWORD_DATABASE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email. Selama MAIL_MAILER=log, email verifikasi/reset password TIDAK terkirim
# (hanya tertulis di storage/logs). Isi SMTP sungguhan, lalu ubah ke `smtp`.
# Contoh Gmail: MAIL_USERNAME = alamat Gmail, MAIL_PASSWORD = "sandi aplikasi"
# (Akun Google > Keamanan > Verifikasi 2 langkah > Sandi aplikasi), port 587.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=GANTI_ALAMAT_EMAIL
MAIL_PASSWORD=GANTI_SANDI_APLIKASI
MAIL_FROM_ADDRESS="GANTI_ALAMAT_EMAIL"
MAIL_FROM_NAME="${APP_NAME}"

# true = akun yang emailnya belum diverifikasi tidak bisa membuat pesanan,
# mendaftar event, atau menulis artikel/komentar. Aktifkan HANYA setelah email
# di atas terbukti terkirim, dan setelah pengguna lama diberi tahu.
REQUIRE_VERIFIED_EMAIL=false

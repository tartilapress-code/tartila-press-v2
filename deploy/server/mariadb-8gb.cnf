# MariaDB / MySQL untuk server 8 GB RAM, 4 vCPU (profil setelah naik paket).
# Dipasang sebagai /etc/mysql/conf.d/99-tartila.cnf oleh deploy/pasang-server.sh 8gb.
#
# Ini menggantikan deploy/server/mariadb-2gb.cnf (nama berkas tujuannya sama, jadi
# tidak bertumpuk). Pengaturan innodb_log_file_size sengaja tidak diubah; lihat
# catatan di mariadb-2gb.cnf.

[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
sql_mode             = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# --- Memori: database ~3,5 GB dari 8 GB (sisanya PHP-FPM, Nginx, Redis, cache berkas OS)
innodb_buffer_pool_size = 3G
innodb_log_buffer_size  = 16M
key_buffer_size         = 32M
tmp_table_size          = 64M
max_heap_table_size     = 64M
sort_buffer_size        = 2M
join_buffer_size        = 2M
read_buffer_size        = 1M
read_rnd_buffer_size    = 1M
thread_cache_size       = 32
table_open_cache        = 2000
table_definition_cache  = 1400

max_connections    = 150
max_allowed_packet = 64M
wait_timeout       = 120

innodb_file_per_table          = 1
innodb_flush_method            = O_DIRECT
innodb_flush_log_at_trx_commit = 2
innodb_io_capacity             = 2000
innodb_io_capacity_max         = 4000

performance_schema = OFF

slow_query_log      = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time     = 1

[mysqldump]
max_allowed_packet = 64M

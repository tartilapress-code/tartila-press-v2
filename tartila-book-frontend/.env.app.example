# Salin menjadi .env.app lalu isi. Dipakai oleh: npm run app:sync  (vite build --mode app)
# Alamat API produksi HARUS HTTPS (aplikasi tidak mengizinkan lalu lintas polos).
VITE_API_URL=https://GANTI_DOMAIN_PRESS/api/v1
# Alamat situs Tartila Press (daftar akun & lupa kata sandi dibuka di peramban sistem).
VITE_PRESS_URL=https://GANTI_DOMAIN_PRESS
# Alamat situs Tartila Book di web (hanya dipakai bila tautan di bawah dinyalakan).
VITE_WEB_URL=https://GANTI_DOMAIN_BOOK
# false = aplikasi tidak menampilkan tautan ke situs untuk beli/langganan (aman untuk aturan Play Store).
VITE_APP_SHOW_WEB_LINK=false
